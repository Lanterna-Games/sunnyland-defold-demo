[project]
title = SunnyLand
version = 1.0

[bootstrap]
main_collection = /main/main.collectionc

[display]
width = 1080
height = 720
high_dpi = 1

[engine]
fixed_update_frequency = 60

[physics]
use_fixed_timestep = 1
debug = 0

[graphics]
default_texture_min_filter = nearest
default_texture_mag_filter = nearest

[render]
clear_color_red = 0.3
clear_color_green = 0.3
clear_color_blue = 0.3

[input]
game_binding = /input/game.input_bindingc

[sprite]
max_count = 512

[tilemap]
max_tile_count = 4096
